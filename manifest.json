{
  "manifest_version": 3,
  "name": "YouTube Queue & Autoplay",
  "version": "1.0.0",
  "description": "Local YouTube video queue with smart autoplay, custom timers, and seamless drag-and-drop reordering.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://noembed.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Queue"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/content.css"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
